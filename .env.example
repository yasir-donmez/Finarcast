# FinCast - Örnek Ortam Değişkenleri
# Bu dosyayı kopyalayıp adını .env olarak değiştirin ve kendi bilgilerinizi girin.
# Kesinlikle .env dosyanızı Git'e pushlamayın!

# Ortam Ayarı (development, production, test)
NODE_ENV=development

# Uygulamanın çalışacağı port
PORT=3000

# Veritabanı Bağlantı URL'si (Örnek: PostgreSQL, MongoDB, vb.)
DATABASE_URL="postgresql://kullanici:sifre@localhost:5432/fincast_db?schema=public"

# Kimlik Doğrulama için Gizli Anahtar (JWT vb.)
# Rastgele, güvenli bir metin oluşturun (Örn: `openssl rand -base64 32`)
AUTH_SECRET="buraya_cok_gizli_ve_uzun_bir_sifre_yazilmalidir"

# Üçüncü Parti API Anahtarları (Örnekler)
# AI Asistanı için (Örn: OpenAI, Gemini)
AI_API_KEY="sk-api-anahtariniz-buraya"

# Ödeme Geçidi (Örn: Stripe, Iyzico, vb.)
PAYMENT_GATEWAY_PUBLIC_KEY="pk_test_anahtar"
PAYMENT_GATEWAY_SECRET_KEY="sk_test_anahtar"
